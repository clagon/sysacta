<Page
    x:Class="Sysacta.App.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="True"
    Title="接続">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitle}" Text="接続" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="MCPエンドポイント (Streamable HTTP, /mcp) の待受設定。すべてのリクエストにBearerトークンが必要です。" />

      <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

      <StackPanel Orientation="Horizontal">
        <ui:Button Appearance="Primary" Command="{Binding StartCommand}" Content="サーバーを開始" Icon="{ui:SymbolIcon Play24}" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
        <ui:Button Command="{Binding StopCommand}" Content="サーバーを停止" Icon="{ui:SymbolIcon Stop24}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        <ui:ProgressRing Width="20" Height="20" Margin="12,0,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <TextBlock Style="{StaticResource SectionHeader}" Text="待受" />
      <Border Style="{StaticResource Surface}">
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="バインド先" />
          <ComboBox MaxWidth="420" HorizontalAlignment="Left" SelectedIndex="{Binding BindMode}" AutomationProperties.Name="バインド先">
            <ComboBoxItem Content="127.0.0.1 — このPCのみ (推奨)" />
            <ComboBoxItem Content="0.0.0.0 — すべてのネットワークインターフェース" />
            <ComboBoxItem Content="特定のIPアドレス" />
          </ComboBox>
          <ui:TextBox Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left" PlaceholderText="例: 192.168.1.10" Text="{Binding CustomAddress, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCustomAddress, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="IPアドレス" />
          <ui:InfoBar Margin="0,8,0,0" IsClosable="False" IsOpen="{Binding ShowExposureWarning, Mode=OneWay}" Severity="Warning" Title="暗号化されていないHTTPで外部に公開されます" Message="リモート利用はlocalhost待受のまま、Tailscale Serve等のHTTPSリバースプロキシを推奨します。公衆インターネットへの直接公開は避けてください。ファイアウォールは自動変更しません。" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="ポート" />
          <ui:NumberBox Width="160" HorizontalAlignment="Left" Minimum="1" Maximum="65535" MaxDecimalPlaces="0" SmallChange="1" Value="{Binding Port, Mode=TwoWay}" AutomationProperties.Name="ポート" />

          <ui:ToggleSwitch Margin="0,16,0,0" Content="アプリ起動時にサーバーを開始する" IsChecked="{Binding StartOnLaunch}" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionHeader}" Text="リバースプロキシとブラウザー" />
      <Border Style="{StaticResource Surface}">
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="追加で許可するホスト名 (1行に1つ)" />
          <TextBlock Style="{StaticResource Caption}" Text="Hostヘッダーの検証 (DNS rebinding対策) に使います。localhost とIPアドレスは常に許可されます。例: pc.tailnet-name.ts.net" />
          <ui:TextBox Margin="0,6,0,0" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding AllowedHosts}" AutomationProperties.Name="許可するホスト名" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="許可するOrigin (1行に1つ)" />
          <TextBlock Style="{StaticResource Caption}" Text="ブラウザーからの接続のみ対象です。空の場合、Originヘッダー付きのリクエストはすべて拒否されます。ワイルドカードは使えません。" />
          <ui:TextBox Margin="0,6,0,0" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding AllowedOrigins}" AutomationProperties.Name="許可するOrigin" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="外部URL (任意)" />
          <TextBlock Style="{StaticResource Caption}" Text="リバースプロキシ経由で使うURL。接続設定のコピーに使われます。" />
          <ui:TextBox Margin="0,6,0,0" PlaceholderText="https://pc.tailnet-name.ts.net/mcp" Text="{Binding ExternalUrl}" AutomationProperties.Name="外部URL" />
        </StackPanel>
      </Border>

      <ui:Button Margin="0,16,0,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="保存して適用" Icon="{ui:SymbolIcon Save24}" />
      <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="実行中の場合はサーバーを再起動します。新しい設定で起動できない場合は以前の設定に戻します。" />

      <TextBlock Style="{StaticResource SectionHeader}" Text="クライアント設定の例" />
      <TextBlock Style="{StaticResource Caption}" Text="形式はクライアントごとに異なります。トークンは「クライアント」ページで発行した値に置き換えてください。" />
      <Border Margin="0,8,0,0" Style="{StaticResource Surface}">
        <Grid>
          <TextBox Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnly="True" Text="{Binding ConfigJson, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="接続設定" />
          <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CopyConfigCommand}" Content="コピー" Icon="{ui:SymbolIcon Copy24}" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
