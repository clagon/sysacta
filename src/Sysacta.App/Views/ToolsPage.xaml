<Page
    x:Class="Sysacta.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ツール">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitle}" Text="ツール" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="サーバー全体でのツールの許可。クライアントが使えるのは、ここで有効かつクライアントごとに許可されたツールだけです。変更は即時に反映されます。" />

      <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <Grid Margin="0,16,0,8">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionHeader}" Margin="0" Text="{Binding Name}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <ui:Button Appearance="Transparent" Command="{Binding EnableAllCommand}" Content="すべて有効" ToolTip="実験的ツールは含みません" />
                  <ui:Button Margin="4,0,0,0" Appearance="Transparent" Command="{Binding DisableAllCommand}" Content="すべて無効" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Surface}" Padding="0">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="16,12" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock FontFamily="Cascadia Mono, Consolas" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                              <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Description}" />
                              <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding PolicyLabel}" />
                              <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12" Text="{Binding AvailabilityText}" TextWrapping="Wrap" Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                              <ui:Button Margin="0,0,16,0" Command="{Binding TestCommand}" Content="動作確認" Icon="{ui:SymbolIcon Beaker24}" ToolTip="読み取り専用ツールを管理コンソールから実行します (監査ログに記録されます)" Visibility="{Binding CanTest, Converter={StaticResource BoolToVisibility}}" />
                              <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Name}" />
                            </StackPanel>
                          </Grid>
                          <TextBox Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" MaxHeight="220" Text="{Binding TestResult, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
