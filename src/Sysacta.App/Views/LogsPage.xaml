<Page
    x:Class="Sysacta.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Sysacta.App.ViewModels"
    ScrollViewer.CanContentScroll="False"
    Title="監査ログ">
  <Grid Margin="32,24,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="監査ログ" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="ツールの実行・拒否・認証失敗の記録。トークン、認証ヘッダー、リクエスト本文は記録されません。" />
      <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="{Binding StorageSummary}" TextWrapping="Wrap" />
    </StackPanel>

    <ui:InfoBar Grid.Row="1" Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
      <ui:TextBox Width="220" Margin="0,0,8,8" Icon="{ui:SymbolIcon Search24}" PlaceholderText="ツール・クライアント・コードで検索" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="検索">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>
      <ComboBox Width="150" Margin="0,0,8,8" ItemsSource="{x:Static vm:LogsViewModel.OutcomeOptions}" SelectedIndex="{Binding OutcomeIndex}" AutomationProperties.Name="結果" />
      <ComboBox Width="190" Margin="0,0,8,8" ItemsSource="{Binding ToolOptions}" SelectedIndex="{Binding ToolIndex}" AutomationProperties.Name="ツール" />
      <ComboBox Width="150" Margin="0,0,8,8" ItemsSource="{x:Static vm:LogsViewModel.KindOptions}" SelectedIndex="{Binding KindIndex}" AutomationProperties.Name="記録の種類" />
      <!-- The date range wraps as one unit. -->
      <StackPanel Margin="0,0,8,8" Orientation="Horizontal">
        <DatePicker Width="140" SelectedDate="{Binding FromDate}" AutomationProperties.Name="開始日" />
        <TextBlock Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="〜" />
        <DatePicker Width="140" SelectedDate="{Binding ToDate}" AutomationProperties.Name="終了日" />
      </StackPanel>
      <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding SearchCommand}" Content="検索" Icon="{ui:SymbolIcon Search24}" />
      <ui:Button Margin="0,0,8,8" Appearance="Transparent" Command="{Binding ClearFiltersCommand}" Content="条件をクリア" />
    </WrapPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource EmptyState}" Text="条件に一致する記録はありません。" Visibility="{Binding HasEvents, Converter={StaticResource InverseBoolToVisibility}}" />
      <ui:DataGrid
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          GridLinesVisibility="None"
          HeadersVisibility="Column"
          IsReadOnly="True"
          ItemsSource="{Binding Events}"
          SelectedItem="{Binding Selected}"
          SelectionMode="Single"
          Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}"
          AutomationProperties.Name="監査ログ一覧">
        <ui:DataGrid.Columns>
          <DataGridTextColumn Width="150" Binding="{Binding Time}" Header="日時" />
          <DataGridTextColumn Width="*" Binding="{Binding Tool}" Header="ツール" />
          <DataGridTextColumn Width="140" Binding="{Binding Client}" Header="クライアント" />
          <DataGridTextColumn Width="110" Binding="{Binding Outcome}" Header="結果" />
          <DataGridTextColumn Width="170" Binding="{Binding ErrorCode}" Header="コード" />
        </ui:DataGrid.Columns>
      </ui:DataGrid>

      <!-- Detail pane -->
      <Border Grid.Column="1" Width="300" Margin="12,0,0,0" Style="{StaticResource Surface}" VerticalAlignment="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding Selected}">
          <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="詳細" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="リクエストID" />
          <TextBox FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" Text="{Binding Event.RequestId, Mode=OneWay}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="経路 / 接続元" />
          <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Remote, Mode=OneWay}" /></TextBlock>
          <TextBlock Style="{StaticResource FieldLabel}" Text="結果 / 所要時間" />
          <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Outcome, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ErrorCode, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Duration, Mode=OneWay}" /></TextBlock>
          <TextBlock Style="{StaticResource FieldLabel}" Text="引数 (許可リストの項目のみ) / 拒否したリクエスト" />
          <TextBox FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" Text="{Binding Arguments, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding ResultSummary}" />
        <ui:ProgressRing Width="16" Height="16" Margin="8,0,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="保持期間 (日)" />
        <ui:NumberBox Width="150" Minimum="1" Maximum="3650" MaxDecimalPlaces="0" Value="{Binding RetentionDays, Mode=TwoWay}" AutomationProperties.Name="保持期間 (日)" />
        <ui:Button Margin="8,0,24,0" Command="{Binding SaveRetentionCommand}" Content="保存" />
        <ui:Button Command="{Binding ExportCsvCommand}" Content="CSV" Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="現在の条件でCSVに書き出し" />
        <ui:Button Margin="8,0,0,0" Command="{Binding ExportJsonCommand}" Content="JSON" Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="現在の条件でJSONに書き出し" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
