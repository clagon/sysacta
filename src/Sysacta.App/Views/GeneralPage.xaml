<Page
    x:Class="Sysacta.App.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Sysacta.App.ViewModels"
    Title="一般">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitle}" Text="一般" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="起動、外観、データの保存場所。" />

      <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

      <Border Style="{StaticResource Surface}">
        <StackPanel>
          <ui:ToggleSwitch Content="Windows へのサインイン時に起動する (タスクトレイに常駐)" IsChecked="{Binding AutoStart}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="テーマ" />
          <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{x:Static vm:GeneralViewModel.ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" AutomationProperties.Name="テーマ" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionHeader}" Text="実行環境" />
      <Border Style="{StaticResource Surface}">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="権限" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource Body}" Text="{Binding PrivilegeText}" />
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,2" Text="データの保存場所" />
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" Style="{StaticResource Body}" Text="{Binding DataDirectory}" />
            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding OpenDataDirectoryCommand}" Content="開く" Icon="{ui:SymbolIcon FolderOpen24}" />
          </StackPanel>
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="設定・トークンのハッシュ・監査ログを含みます。Windowsユーザーのプロファイル権限で保護されますが、同じユーザーで動くプログラムからの改変は防げません。" />
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,2" Text="バージョン" />
          <TextBlock Style="{StaticResource Body}" Text="{Binding Version}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
