<Page
    x:Class="Sysacta.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False"
    Title="デバイス">
  <!-- Fills the window: the device list and the details of the selected device scroll independently. -->
  <Grid Margin="32,24,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="200" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="デバイス" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="ツールで指定できる機器と別名です。別名はこの画面でのみ変更できます。機器が見つからなくなっても、別の機器へ自動で付け替えることはありません。" />
    </StackPanel>

    <ui:InfoBar Grid.Row="1" Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

    <!-- Local recovery of the latest display mode change (also in the tray menu). -->
    <Border Grid.Row="2" Margin="0,0,0,12" Style="{StaticResource Surface}" Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="直前の表示モード変更" />
          <TextBlock Style="{StaticResource Caption}" Text="{Binding RecoveryText}" TextWrapping="Wrap" />
        </StackPanel>
        <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding RestoreModeCommand}" Content="元に戻す" Icon="{ui:SymbolIcon ArrowUndo24}" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,0,0,8">
      <ComboBox HorizontalAlignment="Left" MinWidth="180" ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedItem="{Binding Category}" AutomationProperties.Name="デバイスの種類" />
      <ui:Button HorizontalAlignment="Right" Command="{Binding ReloadCommand}" Content="再読み込み" Icon="{ui:SymbolIcon ArrowSync24}" />
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="220" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="3*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <!-- Master: devices -->
      <TextBlock VerticalAlignment="Top" Style="{StaticResource EmptyState}" Text="{Binding EmptyText}" Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
      <Border Style="{StaticResource Surface}" Padding="4" Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
        <ui:ListView Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="デバイス一覧">
          <ui:ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,6">
                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding AliasText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ui:ListView.ItemTemplate>
        </ui:ListView>
      </Border>

      <!-- Detail: selected device -->
      <TextBlock Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Text="一覧から機器を選ぶと、詳細と別名の管理ができます。" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="0,0,12,0">
          <Border Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Selected.Name}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="ID" />
              <TextBox FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Selected.Id, Mode=OneWay}" AutomationProperties.Name="デバイスID" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="種類 / 状態" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.Summary}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="既定の役割 / プライマリ" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.DefaultText}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="現在値" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedValues}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="対応する操作" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.Operations}" TextWrapping="Wrap" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding IsNetwork, Converter={StaticResource BoolToVisibility}}" Text="この画面からアダプターの有効・無効は変更しません。無効になったアダプターは、この PC の「設定」>「ネットワークとインターネット」>「ネットワークの詳細設定」から有効にできます。" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHeader}" Text="別名" />
          <Border Style="{StaticResource Surface}">
            <StackPanel>
              <ui:ListView MaxHeight="160" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Selected.Aliases}" SelectedItem="{Binding SelectedAlias}" AutomationProperties.Name="別名一覧" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="別名（追加、または選択中の別名の変更）" />
              <ui:TextBox MaxLength="64" PlaceholderText="例: desk" Text="{Binding AliasName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="別名" />
              <WrapPanel Margin="0,8,0,0">
                <ui:Button Margin="0,0,8,0" Command="{Binding AddAliasCommand}" Content="追加" Icon="{ui:SymbolIcon Add24}" />
                <ui:Button Margin="0,0,8,0" Command="{Binding RenameAliasCommand}" Content="変更" Icon="{ui:SymbolIcon Edit24}" />
                <ui:Button Command="{Binding RemoveAliasCommand}" Content="削除" Icon="{ui:SymbolIcon Delete24}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="選択中の別名を別の機器へ再紐付け" />
              <ComboBox ItemsSource="{Binding RebindTargets}" SelectedItem="{Binding RebindTarget}" AutomationProperties.Name="再紐付け先">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ui:Button Margin="0,8,0,0" Command="{Binding RebindAliasCommand}" Content="再紐付け" Icon="{ui:SymbolIcon ArrowSwap24}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
