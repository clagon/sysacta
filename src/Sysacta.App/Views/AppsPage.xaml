<Page
    x:Class="Sysacta.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False"
    Title="アプリ">
  <!-- The page scrolls as a whole (the registration form can be tall at high DPI); each list scrolls within a bounded height. -->
  <ScrollViewer Style="{StaticResource PageScroll}">
  <StackPanel>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="アプリ" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="MCP から起動・終了できるアプリの許可リストです。登録した実行ファイルと固定引数だけが使われ、パスや引数を MCP から指定することはできません。登録しただけでは使えず、許可をオンにしたアプリだけが対象になります。" />
    </StackPanel>

    <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

    <ui:InfoBar Margin="0,0,0,12" IsClosable="False" IsOpen="{Binding IsElevated}" Severity="Warning" Title="管理者として実行中のため、アプリを起動できません" Message="起動したアプリに管理者権限が引き継がれるのを防ぐためです。登録・許可の変更と終了操作は使えます。起動するには、標準ユーザーとして Sysacta を起動し直してください。" />

    <StackPanel Margin="0,0,0,12">
      <WrapPanel>
        <ui:Button Margin="0,0,8,8" Command="{Binding DiscoverCommand}" Content="スタートメニューから検出" Icon="{ui:SymbolIcon Search24}" />
        <ui:Button Margin="0,0,8,8" Command="{Binding PickExecutableCommand}" Content="実行ファイルを選んで登録" Icon="{ui:SymbolIcon Add24}" />
      </WrapPanel>
      <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="登録したアプリ自体ができること（開いたファイルの操作など）は制限できません。信頼できるアプリだけを登録してください。ファイルが更新・置き換えられると、再承認するまで起動できません。" />
    </StackPanel>

    <!-- Registration / re-approval form. -->
    <Border Margin="0,0,0,12" Style="{StaticResource Surface}" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="{Binding DraftTitle}" />
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="実行ファイル" />
        <TextBox IsReadOnly="True" Text="{Binding Draft.Path, Mode=OneWay}" AutomationProperties.Name="実行ファイルのパス" />
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="表示名" />
        <ui:TextBox Width="320" HorizontalAlignment="Left" MaxLength="64" IsEnabled="{Binding IsNewDraft}" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="表示名" />
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="固定引数（1 行に 1 つ）" />
        <TextBox MinHeight="72" MaxHeight="160" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Text="{Binding Draft.Arguments, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="固定引数" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="各行がそのまま 1 つの引数になります（空白で分割せず、引用符や変数も解釈しません）。最大 16 個、1 個 256 文字まで。MCP から引数を追加・変更することはできません。" />
        <WrapPanel Margin="0,12,0,0">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SubmitDraftCommand}" Content="{Binding DraftAction}" Icon="{ui:SymbolIcon Checkmark24}" />
          <ui:Button Appearance="Transparent" Command="{Binding CancelDraftCommand}" Content="キャンセル" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="登録済み" />
        <TextBlock Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Text="登録されたアプリはありません。" Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="4" Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
          <ui:ListView MaxHeight="520" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Apps}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="登録済みアプリ">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ArgumentsText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12" Text="{Binding Status}" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:ToggleSwitch HorizontalAlignment="Right" Content="許可" IsEnabled="{Binding IsValid}" IsChecked="{Binding IsAllowed}" AutomationProperties.Name="{Binding Name}" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                      <ui:Button Command="{Binding ReapproveCommand}" IsEnabled="{Binding IsValid}" Content="再承認" Icon="{ui:SymbolIcon ArrowSync24}" />
                      <ui:Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="削除" Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
        </Border>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="検出した候補" />
        <TextBlock Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding CandidateSummary}" />
        <Border Grid.Row="2" Style="{StaticResource Surface}" Padding="4" Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}">
          <ui:ListView MaxHeight="520" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Candidates}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="検出した候補">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ui:Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding RegisterCommand}" IsEnabled="{Binding CanRegister}" Content="登録…" />
                </Grid>
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
        </Border>
      </Grid>
    </Grid>
  </StackPanel>
  </ScrollViewer>
</Page>
