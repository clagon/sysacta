<Page
    x:Class="Sysacta.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="概要">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitle}" Text="概要" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="MCPサーバーの稼働状態と最近の操作。" />

      <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

      <Border Style="{StaticResource Surface}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Run Text="MCPサーバー: " /><Run Text="{Binding ServerStatus, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
            <StackPanel Margin="20,8,0,0" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" Style="{StaticResource Body}" Text="{Binding EndpointUrl}" />
              <ui:Button Margin="8,0,0,0" Padding="6" Appearance="Transparent" Command="{Binding CopyEndpointCommand}" Icon="{ui:SymbolIcon Copy24}" ToolTip="接続URLをコピー" AutomationProperties.Name="接続URLをコピー" />
            </StackPanel>
            <TextBlock Margin="20,4,0,0" Style="{StaticResource Caption}" Text="{Binding Activity}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
            <ui:ProgressRing Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Appearance="Primary" Command="{Binding StartServerCommand}" Content="開始" Icon="{ui:SymbolIcon Play24}" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button Command="{Binding StopServerCommand}" Content="停止" Icon="{ui:SymbolIcon Stop24}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Caption}" Text="権限レベル" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding PrivilegeText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Caption}" Text="ツール" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ToolSummary}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource Caption}" Text="クライアント" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ClientSummary}" />
        </StackPanel>
      </Grid>

      <TextBlock Style="{StaticResource SectionHeader}" Text="最近の操作" />
      <TextBlock Style="{StaticResource EmptyState}" Text="まだ操作の記録はありません。クライアントを発行し、MCPクライアントから接続すると、ここに表示されます。" Visibility="{Binding HasRecentEvents, Converter={StaticResource InverseBoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding RecentEvents}" Visibility="{Binding HasRecentEvents, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="0,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Time}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Tool}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Client}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Style="{StaticResource Body}" Text="{Binding Outcome}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
