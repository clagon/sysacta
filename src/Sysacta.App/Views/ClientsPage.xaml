<Page
    x:Class="Sysacta.App.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Sysacta.App.ViewModels"
    ScrollViewer.CanContentScroll="True"
    Title="クライアント">
  <!-- Fills the window: the client list and the permissions of the selected client scroll independently. -->
  <Grid Margin="32,24,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="200" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="クライアント" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="MCPクライアントごとにBearerトークンを発行し、使えるツールを個別に許可します。トークンはハッシュのみ保存され、発行時に一度だけ表示されます。" />
    </StackPanel>

    <ui:InfoBar Grid.Row="1" Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

    <!-- One-time token display. -->
    <Border Grid.Row="2" Margin="0,0,0,12" Style="{StaticResource Surface}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding HasIssuedToken, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold">
          <Run Text="「" /><Run Text="{Binding IssuedFor, Mode=OneWay}" /><Run Text="」のトークン" />
        </TextBlock>
        <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="このトークンは二度と表示されません。今すぐクライアントに設定してください。紛失した場合は再発行します。" />
        <TextBox FontFamily="Cascadia Mono, Consolas" IsReadOnly="True" Text="{Binding IssuedToken, Mode=OneWay}" AutomationProperties.Name="発行されたトークン" />
        <WrapPanel Margin="0,8,0,0">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding CopyTokenCommand}" Content="トークンをコピー" Icon="{ui:SymbolIcon Copy24}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding CopyConfigCommand}" Content="接続設定をコピー" Icon="{ui:SymbolIcon Copy24}" />
          <ui:Button Appearance="Transparent" Command="{Binding DismissTokenCommand}" Content="閉じる" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,0,0,16">
      <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="新しいクライアント" />
      <Border Style="{StaticResource Surface}">
        <WrapPanel>
          <StackPanel Margin="0,0,16,8">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="名前" />
            <ui:TextBox Width="240" MaxLength="64" PlaceholderText="例: Claude Desktop" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="クライアント名" />
          </StackPanel>
          <StackPanel Margin="0,0,16,8">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="有効期限" />
            <ComboBox Width="140" ItemsSource="{x:Static vm:ClientsViewModel.ExpiryOptions}" SelectedIndex="{Binding ExpiryIndex}" AutomationProperties.Name="有効期限" />
          </StackPanel>
          <StackPanel Margin="0,0,16,8">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="初期の権限" />
            <ComboBox Width="240" ItemsSource="{x:Static vm:ClientsViewModel.PresetOptions}" SelectedIndex="{Binding PresetIndex}" AutomationProperties.Name="初期の権限" />
          </StackPanel>
          <ui:Button Margin="0,0,0,8" VerticalAlignment="Bottom" Appearance="Primary" Command="{Binding IssueCommand}" Content="発行" Icon="{ui:SymbolIcon Key24}" />
        </WrapPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="220" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="3*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <!-- Master: registered clients -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="登録済み" />
        <TextBlock Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Text="クライアントはまだありません。上のフォームから発行してください。" Visibility="{Binding HasClients, Converter={StaticResource InverseBoolToVisibility}}" />
        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="4" Visibility="{Binding HasClients, Converter={StaticResource BoolToVisibility}}">
          <ui:ListView Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Clients}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="クライアント一覧">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Margin="0,0,8,0" Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding Status}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <Run Text="最終利用 " /><Run Text="{Binding LastUsed, Mode=OneWay}" /><Run Text="  ·  期限 " /><Run Text="{Binding Expires, Mode=OneWay}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
        </Border>
      </Grid>

      <!-- Detail: selected client -->
      <TextBlock Grid.Column="2" Margin="0,40,0,0" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Text="一覧からクライアントを選ぶと、権限の設定と再発行・失効・削除ができます。" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
      <Grid Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionHeader}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis">
            <Run Text="「" /><Run Text="{Binding Selected.Name, Mode=OneWay}" /><Run Text="」の権限" />
          </TextBlock>
          <!-- Same size and style for all actions; destructive ones are confirmed in a dialog instead of being colored. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button Command="{Binding ReissueCommand}" Content="再発行" Icon="{ui:SymbolIcon ArrowSync24}" />
            <ui:Button Margin="8,0,0,0" Command="{Binding RevokeCommand}" Content="失効" Icon="{ui:SymbolIcon ShieldError24}" />
            <ui:Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="削除" Icon="{ui:SymbolIcon Delete24}" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource Caption}" Text="新しく追加されたツールは自動では許可されません。実効権限 = サーバー全体の許可 ∩ このクライアントの許可。" />
        <Border Grid.Row="2" Style="{StaticResource Surface}" Padding="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Permissions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="16,10" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock FontFamily="Cascadia Mono, Consolas" Style="{StaticResource Body}" Text="{Binding ToolName}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                        <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12" Text="{Binding Note}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsAllowed}" AutomationProperties.Name="{Binding ToolName}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
