<Page
    x:Class="Sysacta.App.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Sysacta.App.ViewModels"
    Title="クライアント">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitle}" Text="クライアント" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="MCPクライアントごとにBearerトークンを発行し、使えるツールを個別に許可します。トークンはハッシュのみ保存され、発行時に一度だけ表示されます。" />

      <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasMessage, Mode=TwoWay}" Severity="{Binding MessageSeverity}" Title="{Binding MessageTitle}" Message="{Binding Message}" />

      <!-- One-time token display. -->
      <Border Margin="0,0,0,12" Style="{StaticResource Surface}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding HasIssuedToken, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold">
            <Run Text="「" /><Run Text="{Binding IssuedFor, Mode=OneWay}" /><Run Text="」のトークン" />
          </TextBlock>
          <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="このトークンは二度と表示されません。今すぐクライアントに設定してください。紛失した場合は再発行します。" />
          <TextBox FontFamily="Cascadia Mono, Consolas" IsReadOnly="True" Text="{Binding IssuedToken, Mode=OneWay}" AutomationProperties.Name="発行されたトークン" />
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <ui:Button Appearance="Primary" Command="{Binding CopyTokenCommand}" Content="トークンをコピー" Icon="{ui:SymbolIcon Copy24}" />
            <ui:Button Margin="8,0,0,0" Command="{Binding CopyConfigCommand}" Content="接続設定をコピー" Icon="{ui:SymbolIcon Copy24}" />
            <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding DismissTokenCommand}" Content="閉じる" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionHeader}" Margin="0,8,0,8" Text="新しいクライアント" />
      <Border Style="{StaticResource Surface}">
        <WrapPanel>
          <StackPanel Margin="0,0,16,0">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="名前" />
            <ui:TextBox Width="240" MaxLength="64" PlaceholderText="例: Claude Desktop" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="クライアント名" />
          </StackPanel>
          <StackPanel Margin="0,0,16,0">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="有効期限" />
            <ComboBox Width="140" ItemsSource="{x:Static vm:ClientsViewModel.ExpiryOptions}" SelectedIndex="{Binding ExpiryIndex}" AutomationProperties.Name="有効期限" />
          </StackPanel>
          <StackPanel Margin="0,0,16,0">
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="初期の権限" />
            <ComboBox Width="240" ItemsSource="{x:Static vm:ClientsViewModel.PresetOptions}" SelectedIndex="{Binding PresetIndex}" AutomationProperties.Name="初期の権限" />
          </StackPanel>
          <ui:Button Margin="0,0,0,0" VerticalAlignment="Bottom" Appearance="Primary" Command="{Binding IssueCommand}" Content="発行" Icon="{ui:SymbolIcon Key24}" />
        </WrapPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionHeader}" Text="登録済み" />
      <TextBlock Style="{StaticResource EmptyState}" Text="クライアントはまだありません。上のフォームから発行してください。" Visibility="{Binding HasClients, Converter={StaticResource InverseBoolToVisibility}}" />
      <!-- Same surface as the other lists; the Fluent ListView provides the selection indicator. -->
      <Border Style="{StaticResource Surface}" Padding="4" Visibility="{Binding HasClients, Converter={StaticResource BoolToVisibility}}">
        <ui:ListView MaxHeight="300" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Clients}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="クライアント一覧">
          <ui:ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <Run Text="作成 " /><Run Text="{Binding Created, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Body}" Text="{Binding Status}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Caption}" Text="有効期限" />
                  <TextBlock Style="{StaticResource Body}" Text="{Binding Expires}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Caption}" Text="最終利用" />
                  <TextBlock Style="{StaticResource Body}" Text="{Binding LastUsed}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ui:ListView.ItemTemplate>
        </ui:ListView>
      </Border>

      <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid Margin="0,24,0,8">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionHeader}" Margin="0">
            <Run Text="「" /><Run Text="{Binding Selected.Name, Mode=OneWay}" /><Run Text="」の権限" />
          </TextBlock>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Command="{Binding ReissueCommand}" Content="再発行" Icon="{ui:SymbolIcon ArrowSync24}" />
            <ui:Button Margin="8,0,0,0" Command="{Binding RevokeCommand}" Content="失効" Icon="{ui:SymbolIcon ShieldError24}" />
            <ui:Button Margin="8,0,0,0" Appearance="Danger" Command="{Binding DeleteCommand}" Content="削除" Icon="{ui:SymbolIcon Delete24}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,0,0,8" Style="{StaticResource Caption}" Text="新しく追加されたツールは自動では許可されません。実効権限 = サーバー全体の許可 ∩ このクライアントの許可。" />
        <Border Style="{StaticResource Surface}" Padding="0">
          <ItemsControl ItemsSource="{Binding Permissions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="16,10" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                  <Grid>
                    <StackPanel>
                      <TextBlock FontFamily="Cascadia Mono, Consolas" Style="{StaticResource Body}" Text="{Binding ToolName}" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                      <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12" Text="{Binding Note}" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IsAllowed}" AutomationProperties.Name="{Binding ToolName}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
