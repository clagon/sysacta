root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,xaml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Noise for an application (not a reusable library):
dotnet_diagnostic.CA1716.severity = none   # keyword-like parameter names
dotnet_diagnostic.CA1001.severity = none   # process-lifetime singletons own SemaphoreSlim
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates
dotnet_diagnostic.CA1515.severity = none   # make public types internal
dotnet_diagnostic.CA1711.severity = none   # identifier suffixes
dotnet_diagnostic.CA1707.severity = none   # underscores in test names
dotnet_diagnostic.CA1305.severity = none   # IFormatProvider (invariant culture used where it matters)
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait in app/test code

[src/Sysacta.App/**.cs]
dotnet_diagnostic.CA1822.severity = none   # view-model properties are bound by instance
dotnet_diagnostic.CA1859.severity = none   # RelayCommand methods return Task by design
