<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests against real Windows APIs. Skipped automatically on non-Windows hosts or machines without the required device. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sysacta.Windows\Sysacta.Windows.csproj" />
    <!-- Built only to be launched by the app tests (a dedicated harmless process); not referenced as an assembly. -->
    <ProjectReference Include="..\HarmlessTarget\HarmlessTarget.csproj" ReferenceOutputAssembly="false" Private="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HarmlessTargetDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\HarmlessTarget\bin\$(Configuration)\net10.0\</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
